# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
# Configure via the Secrets panel in the AI Studio UI.
SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_ANON_KEY: Your Supabase project anon/public key for authentication and RLS.
# Configure via the Secrets panel in the AI Studio UI.
SUPABASE_ANON_KEY="your-supabase-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Optional server-side Supabase service role key for bucket provisioning and admin routes.
# Configure via the Secrets panel in the AI Studio UI. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
